{
  "name": "NEAT Continuous v1",
  "algorithm": "NEAT",
  "pipeline_version": 2,
  "library": "neat-python",
  "library_version": "2.0.0",
  "neat_config": "configs/neat_continuous_v1.ini",
  "action_space": "Continuous",
  "observation_size": 236,
  "outputs": ["STEERING"],
  "episodes_per_genome": 2,
  "population_size": 64,
  "workers": 6,
  "time_scale": 20,
  "training_max_duration": 300,
  "target_generations": 200,
  "interaction_match_transitions": 5000000,
  "validation_interval": 500000,
  "validation_workers": 6,
  "validation_max_duration": 300,
  "validation_after_first_generation": true,
  "milestone_generations": [50, 100, 150, 200],
  "experiment_seed": 20260925,
  "checkpoint_each_generation": true,
  "fitness": {
    "score_divisor": 100,
    "life_loss_penalty": 0.5
  },
  "speciation_preflight": {
    "compatibility_threshold": 2.5,
    "initial_connection": "partial_direct",
    "connection_fraction": 0.10,
    "required_stable_species_min": 2,
    "required_stable_species_max": 8
  }
}
